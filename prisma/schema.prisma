// Tados Web — Prisma schema
// PostgreSQL (pgAdmin)

generator client {
  provider = "prisma-client-js"
}

// `url` is Supabase's transaction-mode pooler (port 6543) — the right mode for
// short-lived queries, and the only one that survives serverless. Session mode
// (5432) holds one real Postgres connection per client for its whole lifetime,
// so a dev server or a fleet of Vercel functions exhausts the pooler and Prisma
// reports the refusal as "Can't reach database server".
//
// Migrations can't run through transaction mode — they need a real session for
// advisory locks and DDL — so `directUrl` points at 5432. Kept on the pooler
// host rather than the `db.<ref>.supabase.co` direct host, which is IPv6-only
// and unreachable from IPv4 networks.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  phone         String?
  role          Role      @default(CUSTOMER)

  accounts  Account[]
  sessions  Session[]
  orders    Order[]
  addresses Address[]
  reviews   Review[]
  wishlist  WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------
// CATALOGUE
// ---------------------------------------------------------------

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  image       String?
  icon        String? // lucide icon name
  position    Int     @default(0)
  featured    Boolean @default(false)

  // self-relation => parent categories + sub categories
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([slug])
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  logo     String?
  products Product[]

  createdAt DateTime @default(now())
}

model Product {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  sku         String @unique
  // Short marketing line used on cards + meta description
  tagline     String?
  description String @db.Text

  // Pricing in ZAR
  price        Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  costPrice    Decimal? @db.Decimal(10, 2)

  stock     Int     @default(0)
  lowStockAt Int    @default(5)

  isActive     Boolean @default(true)
  isFeatured   Boolean @default(false)
  isBestseller Boolean @default(false)
  isNewArrival Boolean @default(false)

  // Denormalised rating for fast sorting/listing
  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  // Structured feature bullets from the product sheet
  features Json?
  specs    Json?

  // SEO overrides
  metaTitle       String?
  metaDescription String? @db.Text

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  images     ProductImage[]
  reviews    Review[]
  orderItems OrderItem[]
  wishlist   WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([slug])
  @@index([isActive, isFeatured])
  @@index([isActive, isBestseller])
  @@index([isActive, isNewArrival])
  @@index([price])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Review {
  id        String  @id @default(cuid())
  productId String
  userId    String
  rating    Int
  title     String?
  body      String? @db.Text
  approved  Boolean @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([productId, userId])
  @@index([productId])
}

model WishlistItem {
  id        String @id @default(cuid())
  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

// ---------------------------------------------------------------
// ORDERS + PAYMENTS
// ---------------------------------------------------------------

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETE
  FAILED
  CANCELLED
}

model Address {
  id         String  @id @default(cuid())
  userId     String?
  firstName  String
  lastName   String
  phone      String
  line1      String
  line2      String?
  city       String
  province   String
  postalCode String
  country    String  @default("South Africa")

  // Optional: guest checkout creates an address with no user attached.
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  createdAt DateTime @default(now())

  @@index([userId])
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Guest checkout support
  email String
  phone String?

  addressId String?
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  subtotal Decimal @db.Decimal(10, 2)
  shipping Decimal @db.Decimal(10, 2) @default(0)
  tax      Decimal @db.Decimal(10, 2) @default(0)
  discount Decimal @db.Decimal(10, 2) @default(0)
  total    Decimal @db.Decimal(10, 2)

  status OrderStatus @default(PENDING)
  notes  String?     @db.Text

  items   OrderItem[]
  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([orderNumber])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String

  // Snapshot fields (so history survives product edits/deletes)
  name     String
  sku      String
  image    String?
  price    Decimal @db.Decimal(10, 2)
  quantity Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id      String @id @default(cuid())
  orderId String @unique

  provider String        @default("payfast")
  status   PaymentStatus @default(PENDING)
  amount   Decimal       @db.Decimal(10, 2)

  // PayFast ITN fields
  pfPaymentId String?
  signature   String?
  rawPayload  Json?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}
